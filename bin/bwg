#!/usr/bin/env bash
set -euo pipefail

DOTFILES_PATH="${DOTFILES_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/.dotfiles}"
# shellcheck source=../lib/secret.sh
source "$DOTFILES_PATH/lib/secret.sh"

die() { printf 'bwg: %s\n' "$1" >&2; exit 1; }

mode=type
if [ "${1:-}" = -c ]; then
  mode=copy
  shift
fi
length="${1:-20}"
[[ "$length" =~ ^[0-9]{1,3}$ ]] && ((10#$length >= 8 && 10#$length <= 128)) || die "usage: bwg [-c] [length 8-128]"
command -v bw >/dev/null || die "bw is not installed"
value="$(bw generate -ulns --length "$((10#$length))" --minNumber 1 --minSpecial 1)"
[ -n "$value" ] || die "generate failed"
secret_deliver "${#value} characters" "$value" 120 "$mode" || die "delivery failed"

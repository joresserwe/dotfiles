#!/usr/bin/env bash
set -euo pipefail

DOTFILES_PATH="${DOTFILES_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/.dotfiles}"
# shellcheck source=../lib/secret.sh
source "$DOTFILES_PATH/lib/secret.sh"

die() { printf 'bwc: %s\n' "$1" >&2; exit 1; }

for tool in bw jq fzf; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done

opened=
finish() {
  if [ -n "$opened" ]; then
    trap '' HUP
    bw lock >/dev/null 2>&1 &
  fi
}
trap finish EXIT

case "$(bw status 2>/dev/null | jq -r .status)" in
  unauthenticated) BW_SESSION="$(bw login --raw)" || die "login failed"; opened=1 ;;
  locked) BW_SESSION="$(bw unlock --raw)" || die "unlock failed"; opened=1 ;;
  unlocked) ;;
  *) die "cannot read the vault status" ;;
esac
[ -n "${BW_SESSION:-}" ] || die "no session"
export BW_SESSION

printf 'Loading the vault...' >&2
bw sync >/dev/null 2>&1 || printf '\r\033[Kbwc: sync failed, using the saved copy\n' >&2
items="$(bw list items | jq -c '[.[] | select(.type == 1 and .login != null)]')"
printf '\r\033[K' >&2
[ "$items" != "[]" ] || die "no logins in the vault"

picked="$(printf '%s' "$items" | jq -r '
  def clean: (. // "") | gsub("[[:cntrl:]]"; " ");
  def cell: if . >= 4352 then 2 else 1 end;
  def width: [explode[] | cell] | add // 0;
  def cut(n): reduce explode[] as $c ({s: [], w: 0}; .w += ($c | cell) | if .w <= n then .s += [$c] else . end) | .s | implode;
  def fit(n): (if width > n then cut(n - 1) + "…" else . end) | . + ([range(n - width) | " "] | add // "");
  def host: clean | sub("^[a-z]+://"; "") | sub("^www\\."; "") | split("/")[0];
  sort_by(.name | ascii_downcase)[]
  | [.id,
     "\u001b[1m" + (.name | clean | fit(28)) + "\u001b[0m  "
     + "\u001b[36m" + (.login.username | clean | fit(28)) + "\u001b[0m  "
     + "\u001b[2m" + (.login.uris[0]?.uri | host) + "\u001b[0m"]
  | @tsv' | fzf --ansi --delimiter='\t' --with-nth=2.. --height=60% --layout=reverse --border --info=inline \
  --prompt='vault > ' --header='Enter: password   Ctrl-U: username   Ctrl-Y: copy password   Esc: cancel' \
  --expect=ctrl-u,ctrl-y --query="$*")" || exit 0

key="$(printf '%s\n' "$picked" | sed -n 1p)"
id="$(printf '%s\n' "$picked" | sed -n 2p | cut -f1)"
field=password
mode=type
[ "$key" != ctrl-u ] || field=username
[ "$key" != ctrl-y ] || mode=copy

value="$(printf '%s' "$items" | jq -r --arg id "$id" --arg f "$field" '.[] | select(.id == $id) | .login[$f] // ""')"
name="$(printf '%s' "$items" | jq -r --arg id "$id" '.[] | select(.id == $id) | .name | gsub("[[:cntrl:]]"; " ")')"
[ -n "$value" ] || die "$name has no $field"
secret_deliver "$name $field" "$value" 30 "$mode" || die "delivery failed"

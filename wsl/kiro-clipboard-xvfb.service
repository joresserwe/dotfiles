[Unit]
Description=Authenticated headless X11 clipboard for Kiro CLI image paste

[Service]
Type=simple
ExecStartPre=/usr/bin/rm -f /run/user/%U/kiro-clipboard.Xauthority
ExecStartPre=/bin/sh -c 'umask 077; /usr/bin/xauth -f /run/user/%U/kiro-clipboard.Xauthority add :99 . "$(/usr/bin/mcookie)"'
ExecStart=/usr/bin/Xvfb :99 -screen 0 1x1x8 -nolisten tcp -noreset -auth /run/user/%U/kiro-clipboard.Xauthority
ExecStopPost=/usr/bin/rm -f /run/user/%U/kiro-clipboard.Xauthority
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

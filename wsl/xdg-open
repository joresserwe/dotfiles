#!/usr/bin/env bash
# xdg-open shim for WSL: wslu/wslview is gone from Ubuntu 26.04 archives, so
# route to the Windows default handler instead. Files become UNC paths (most
# Windows apps accept them); URLs pass through untouched.
set -euo pipefail

target="${1:?usage: xdg-open <file|url>}"
if [[ "$target" == *://* ]]; then
  win="$target"
else
  win="$(wslpath -w "$(realpath "$target")")"
fi
export XDG_OPEN_TARGET="$win"
export WSLENV="${WSLENV:+$WSLENV:}XDG_OPEN_TARGET"
# powershell.exe by absolute path: launcher-spawned sessions (e.g. Flow -> wt ->
# wsl -e) inherit a stripped Windows PATH, so bare powershell.exe resolves to nothing.
exec /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive \
  -Command 'Start-Process -FilePath $env:XDG_OPEN_TARGET' </dev/null 2>/dev/null

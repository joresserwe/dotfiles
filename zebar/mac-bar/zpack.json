{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "mac-bar",
  "version": "0.1.0",
  "description": "Slim macOS-menubar-style top bar for glazewm.",
  "tags": ["topbar"],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js", "*.txt", "market.json", "quotes.json", "quotes-hist.json", "gpu-usage.ps1", "watch-ime.ahk"],
      "caching": { "defaultDuration": 604800, "rules": [] },
      "privileges": {
        "shellCommands": [
          { "program": "cmd.exe", "argsRegex": "^/c echo [0-9 ]+ > %TEMP%\\\\glazewm-jump-map\\.txt$" },
          { "program": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe", "argsRegex": "^/ErrorStdOut \\.\\\\watch-ime\\.ahk$" },
          { "program": "powershell.exe", "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \\.\\\\gpu-usage\\.ps1$" }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "26px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": { "enabled": false, "edge": "top", "windowMargin": "0px" }
        }
      ]
    },
    {
      "name": "market",
      "htmlPath": "./bar.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js", "market.json", "quotes.json", "quotes-hist.json"],
      "caching": { "defaultDuration": 604800, "rules": [] },
      "privileges": { "shellCommands": [] },
      "presets": [
        {
          "name": "pinned",
          "anchor": "top_right",
          "offsetX": "-20px",
          "offsetY": "32px",
          "width": "850px",
          "height": "716px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": "top", "windowMargin": "0px" }
        }
      ]
    }
  ]
}

      "unsandboxed(tail)",
      "unsandboxed(tcping)",
      "unsandboxed(tee)",
      "unsandboxed(test)",
      "unsandboxed(tmux)",
      "unsandboxed(touch)",
      "unsandboxed(tr)",
      "unsandboxed(true)",
      "unsandboxed(uniq)",
      "unsandboxed(uv)",
      "unsandboxed(uvx)",
      "unsandboxed(wc)",
      "unsandboxed(wget)",
      "unsandboxed(which)",
      "unsandboxed(win32yank.exe)",
      "unsandboxed(wslpath)",

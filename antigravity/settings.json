{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "altScreenMode": "always",
  "notifications": true,
  "runningLightSpeed": "medium",
  "toolPermission": "always-proceed",
  "permissions": {
    "allow": [
      "command(*)",
      "execute_url(*)",
      "mcp(*)",
      "read_file(*)",
      "read_file(/etc)",
      "read_file(/proc)",
      "read_file(/tmp)",
      "read_file(/var/log)",
      "read_file(~/.config/.dotfiles)",
      "read_file(~/.gemini)",
      "read_file(~/.local/share)",
      "read_file(~/Workspace)",
      "read_url(*)",
      "unsandboxed(./gradlew)",
      "unsandboxed(/home/linuxbrew/.linuxbrew/bin/tmux)",
      "unsandboxed(/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe)",
      "unsandboxed(/mnt/c/Windows/System32/cmd.exe)",
      "unsandboxed(/mnt/c/Windows/System32/curl.exe)",
      "unsandboxed(/mnt/c/nvm4w/nodejs/node.exe)",
      "unsandboxed(/opt/homebrew/bin/tmux)",
      "unsandboxed(agy)",
      "unsandboxed(awk)",
      "unsandboxed(aws)",
      "unsandboxed(az)",
      "unsandboxed(bq)",
      "unsandboxed(brew)",
      "unsandboxed(bun)",
      "unsandboxed(bunx)",
      "unsandboxed(cargo)",
      "unsandboxed(cat)",
      "unsandboxed(chmod)",
      "unsandboxed(clip.exe)",
      "unsandboxed(cmd.exe)",
      "unsandboxed(cp)",
      "unsandboxed(curl)",
      "unsandboxed(curl.exe)",
      "unsandboxed(cut)",
      "unsandboxed(diff)",
      "unsandboxed(dig)",
      "unsandboxed(docker)",
      "unsandboxed(docker-compose)",
      "unsandboxed(echo)",
      "unsandboxed(env)",
      "unsandboxed(eza)",
      "unsandboxed(false)",
      "unsandboxed(fd)",
      "unsandboxed(file)",
      "unsandboxed(find)",
      "unsandboxed(gcloud)",
      "unsandboxed(gh)",
      "unsandboxed(git clone)",
      "unsandboxed(git fetch)",
      "unsandboxed(git ls-remote)",
      "unsandboxed(git pull)",
      "unsandboxed(git remote)",
      "unsandboxed(git status)",
      "unsandboxed(git submodule)",
      "unsandboxed(go)",
      "unsandboxed(gradle)",
      "unsandboxed(grep)",
      "unsandboxed(gsutil)",
      "unsandboxed(head)",

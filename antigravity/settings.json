      "unsandboxed(jq)",
      "unsandboxed(kubectl)",
      "unsandboxed(ln)",
      "unsandboxed(ls)",
      "unsandboxed(lsof)",
      "unsandboxed(mise)",
      "unsandboxed(mkdir)",
      "unsandboxed(mv)",
      "unsandboxed(mvn)",
      "unsandboxed(nc)",
      "unsandboxed(netstat)",
      "unsandboxed(npm)",
      "unsandboxed(npx)",
      "unsandboxed(nslookup)",
      "unsandboxed(pgrep)",
      "unsandboxed(ping)",
      "unsandboxed(pip)",
      "unsandboxed(pip3)",
      "unsandboxed(pnpm)",
      "unsandboxed(podman)",
      "unsandboxed(poetry)",
      "unsandboxed(powershell.exe)",
      "unsandboxed(printf)",
      "unsandboxed(ps)",
      "unsandboxed(pwd)",
      "unsandboxed(readlink)",
      "unsandboxed(realpath)",

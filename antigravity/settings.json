      "unsandboxed(rg)",
      "unsandboxed(rsync)",
      "unsandboxed(scp)",
      "unsandboxed(sed)",
      "unsandboxed(sleep)",
      "unsandboxed(sort)",
      "unsandboxed(ss)",
      "unsandboxed(ssh)",
      "unsandboxed(stat)",

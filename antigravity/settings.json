    "ask": [
      "command(/bin/rm)",
      "command(/usr/bin/rm)",
      "command(dd)",
      "command(git clean)",
      "command(git push)",
      "command(git reset --hard)",
      "command(regex:mkfs(\\..+)?)",
      "command(rm)",
      "command(rmdir)",
      "command(shred)",
      "command(sudo)",
      "command(unlink)",
      "unsandboxed(/bin/rm)",
      "unsandboxed(/usr/bin/rm)",
      "unsandboxed(dd)",
      "unsandboxed(git clean)",
      "unsandboxed(git push)",
      "unsandboxed(git reset --hard)",
      "unsandboxed(regex:mkfs(\\..+)?)",
      "unsandboxed(rm)",
      "unsandboxed(rmdir)",
      "unsandboxed(shred)",
      "unsandboxed(sudo)",
      "unsandboxed(unlink)"
    ],
    "deny": [
      "read_file(~/.aws/credentials)",
      "read_file(~/.config/gh/hosts.yml)",
      "read_file(~/.config/git/config.local)",
      "read_file(~/.git-credentials)",
      "read_file(~/.local/share/atuin/key)",
      "read_file(~/.local/share/claude/.credentials.json)",
      "read_file(~/.local/share/codex/auth.json)",
      "read_file(~/.netrc)",
      "read_file(~/.ssh)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${DOTFILES_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/.dotfiles}/antigravity/statusline.sh\""
  }
}

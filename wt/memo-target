#!/usr/bin/zsh -l

start=""
if [[ "$1" == --start ]]; then
  start=1
  shift
fi

sock="${XDG_CACHE_HOME:-$HOME/.cache}/nvim/memo.sock"
if [[ -z "$start" && ! -S "$sock" ]]; then
  exit 1
fi

files=()
if [[ -n "$1" ]]; then
  win_file="$(printf %s "$1" | base64 --decode)" || exit 1
  file="$(wslpath -u "$win_file")" || exit 1
  [[ -f "$file" ]] || exit 1
  files+=("$file")
fi

if [[ -n "$start" ]]; then
  NVIM_MEMO_OPEN_FILE="${files[1]}" MEMO_TARGET_ENV=1 exec "$HOME/.local/bin/memo-run"
fi

where="$(nvim --headless --server "$sock" --remote-expr '$TMUX . "|" . $TMUX_PANE')" || exit 1
if (( ${#files} )); then
  nvim --server "$sock" --remote "${files[@]}" || exit 1
fi
pane="${where#*|}"
if [[ -n "$pane" ]] && tmux -S "${where%%,*}" switch-client -t "$pane" 2>/dev/null; then
  echo tmux
fi
